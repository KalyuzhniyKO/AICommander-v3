# Legacy direct OpenRouter transport (optional, separate from OmniRoute).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_TIMEOUT_SECONDS=60
# Total attempts per model, including the first call (minimum 1).
MAX_MODEL_RETRIES=1
# OmniRoute is opt-in; use loopback/SSH tunnel or HTTPS. No key in Git.
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_TIMEOUT_SECONDS=10
OMNIROUTE_MAX_GET_ATTEMPTS=2
OMNIROUTE_MAX_OUTPUT_TOKENS=256
DATABASE_URL=sqlite:///./aicommander.db

# Авторизация панели: пароль минимум 32 символа, только на сервере.
# Создать пароль: python -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_USER=owner
PANEL_PASSWORD=

# Hermes planning v2: opt-in, installed trusted POSIX runtime on the app host.
HERMES_ENABLED=false
HERMES_PYTHON=
HERMES_SOURCE=
HERMES_EXPECTED_COMMIT=
HERMES_MODEL=
HERMES_TIMEOUT_SECONDS=90
HERMES_MAX_OUTPUT_TOKENS=768

# Optional read-only saved QA bundles. Absolute dedicated evidence directory;
# empty disables the viewer. No recursive search, execution or task attachment.
LOCAL_REVIEW_ROOT=
